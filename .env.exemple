# --- Obligatoires ----------------------------------------------------------
# Clé API OpenAI : à saisir UNIQUEMENT dans les variables d'environnement de l'hébergeur.
OPENAI_API_KEY=
# Modèle de l'agent (choisir dans la console OpenAI un modèle compatible avec l'outil Code Interpreter).
OPENAI_MODELE=
# Secret partagé avec le connecteur Claude (48 caractères aléatoires) :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_SECRET=
# Dépôts GitHub dont le relais accepte de lire des fichiers (séparés par des virgules).
DEPOTS_AUTORISES=proprietaire/depot-de-test

# --- Facultatifs -----------------------------------------------------------
# Nom d'hôte public du service, pour la protection contre le « DNS rebinding ».
MCP_HOTES_AUTORISES=
# Jeton GitHub en lecture seule, uniquement si le dépôt est privé.
GITHUB_TOKEN=
OPENAI_MEMOIRE_CONTENEUR=1g

# --- Limites de dépense (bloquantes, appliquées par le relais) -------------
MAX_APPELS_JOUR=20
MAX_EXECUTIONS_JOUR=20
MAX_JETONS_TOTAL=300000
# Réserve prudente par appel, comptée avant l'appel ; à relever si le journal signale « reserve_depassee ».
RESERVE_JETONS_PAR_APPEL=50000
MAX_JETONS_SORTIE_PAR_APPEL=4000
MAX_APPELS_OUTIL_PAR_REPONSE=3
# Coupe-circuit : 1 = tout appel est refusé.
PAUSE=0

# --- Délais ----------------------------------------------------------------
ATTENTE_SYNCHRONE=25
# Échéance stricte d'une tâche ; au-delà elle est « expiree » et la réponse OpenAI est annulée.
DELAI_MAX_TACHE=600
# Durée maximale d'exécution du fichier dans le conteneur.
DELAI_EXECUTION_FICHIER=120
# 1 : réponse OpenAI en arrière-plan, annulable ; 0 : appel synchrone coupé côté client.
OPENAI_MODE_ARRIERE_PLAN=1
CHEMIN_BASE=/donnees/relais.sqlite3
